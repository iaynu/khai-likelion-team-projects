{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PopulationList",
  "description": "population payload: array of population analysis records",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "population_analysis",
      "raw_data_context",
      "metadata"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "population_analysis": {
        "type": "object",
        "required": [
          "overall_summary"
        ],
        "properties": {
          "overall_summary": {
            "type": "string"
          },
          "gender_structure": {
            "type": [
              "string",
              "null"
            ]
          },
          "age_structure": {
            "type": [
              "string",
              "null"
            ]
          },
          "temporal_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "working_population_summary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "dimension_analysis": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "by_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "by_weekday": {
            "type": [
              "string",
              "null"
            ]
          },
          "by_age": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "raw_data_context": {
        "type": "object",
        "required": [
          "metrics"
        ],
        "properties": {
          "source_snapshots": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object"
            }
          },
          "metrics": {
            "type": "object",
            "required": [
              "reside_total",
              "floating_total"
            ],
            "properties": {
              "reside_total": {
                "type": "number"
              },
              "floating_total": {
                "type": "number"
              },
              "processed_time_total_sum": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "weekend_weekday_ratio_floating": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "working_total": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "working_male": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "working_female": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "working_to_floating_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "dimension_columns": {
            "type": [
              "object",
              "null"
            ]
          },
          "dimension_breakdowns": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "metadata": {
        "type": "object",
        "required": [
          "area_code",
          "quarter"
        ],
        "properties": {
          "area_code": {
            "type": "string"
          },
          "area_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "quarter": {
            "type": "string"
          },
          "data_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "korean_field_description": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  }
}
